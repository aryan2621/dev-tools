{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wall",
  "version": "0.1.0",
  "identifier": "app.wall.desktop",
  "build": {
    "beforeDevCommand": "./scripts/build-llama-server.sh && npm run dev",
    "devUrl": "http://127.0.0.1:1520",
    "beforeBuildCommand": "./scripts/build-llama-server.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Wall",
        "width": 1180,
        "height": 760,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "minWidth": 720,
        "minHeight": 480,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1520 ws://127.0.0.1:1520; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/llama-server"
    ]
  }
}